packages:
    .

-- `hs-opentelemetry-api` usa la API de `Ref` de thread-utils-context, que
-- apareció en 0.4.1.1, pero declara `>= 0.3 && < 0.5`. Con ese bound el solver
-- puede elegir 0.3.0.4 y entonces la compilación de otel falla con
-- "Variable not in scope: ensureRef" — un error que parece de otel pero es de
-- resolución.
--
-- El `source-repository-package` de abajo ya fija la versión, así que esto es
-- redundante hoy; queda porque documenta el problema de upstream y porque si
-- algún día se saca el pin, es lo que evita volver a caer en 0.3.
constraints:
    thread-utils-context >= 0.4.1.1

source-repository-package
    type: git
    location: https://github.com/msakai/haskell-MIP.git
    tag: 0c602fc593155b2ebf82f15b0325ac439e2c7bcc
    subdir: MIP

-- OpenTelemetry desde el repo, igual que MIP y conferer, y no desde Hackage.
-- Los paquetes del monorepo se publican juntos y se referencian entre ellos con
-- bounds exactos (`== 1.0.*`), así que mezclar fuentes es pedir problemas; y los
-- que hay en nixpkgs son de 2023 (solo traces) o están marcados como broken.
--
-- `flake.nix` tiene el mismo commit y la misma lista de subdirectorios, así que
-- el build de cabal y el de Nix usan exactamente el mismo código. **Si agregás
-- un subdirectorio acá, va también allá.**
--
-- La lista es `sdk` y todo lo que arrastra: el SDK depende de todos los
-- propagadores y de los exporters, aunque se elija uno solo por
-- OTEL_PROPAGATORS / OTEL_*_EXPORTER. `exporters/in-memory` lo usa el
-- test-suite del sdk, que es lo que corre el build de Nix.
source-repository-package
    type: git
    location: https://github.com/iand675/hs-opentelemetry.git
    tag: 5a267e690941bc3817b1de8dbd496cb35bb4788c
    subdir:
        api
        api-types
        semantic-conventions
        otlp
        sdk
        exporters/handle
        exporters/in-memory
        exporters/otlp
        instrumentation/ghc-metrics
        propagators/b3
        propagators/datadog
        propagators/jaeger
        propagators/w3c
        propagators/xray

-- Ver el `constraints` de arriba. Va del repo y no de Hackage para que los dos
-- builds usen el mismo commit: del lado de Nix no queda otra, porque 0.4.1.1 es
-- más nueva que el snapshot de `all-cabal-hashes` que trae nuestro nixpkgs y
-- pedirla por versión falla con "thread-utils-context.cabal: Not found in
-- archive".
source-repository-package
    type: git
    location: https://github.com/iand675/thread-utils.git
    tag: 4a981ca2a0dd67cb6dce81cb8465612cfb3b1ced
    subdir: thread-utils-context
